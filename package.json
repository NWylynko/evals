{
  "name": "pi-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "infisical run --env=dev -- node src/pi-harness/runEvalMatrix.ts",
    "eval:single": "infisical run --env=dev -- vitest run",
    "eval:watch": "infisical run --env=dev -- vitest",
    "report": "node src/pi-harness/serveEvalReport.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fastify/static": "^10.1.2",
    "@types/node": "^24.10.1",
    "fastify": "^5.11.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "varlock": "^1.24.0"
  }
}
